{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustRss",
  "version": "0.0.0",
  "identifier": "tech.expoli.rustrss",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RustRss",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "News",
  "linux": {
    "deb": {
      "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
    }
  },
    "shortDescription": "本地优先的 RSS 阅读器",
    "longDescription": "RustRss 是一个本地优先的跨平台 RSS 阅读器：订阅与已读状态存在本地 SQLite，内置 AI（自带 key）与 MCP 服务器（可让外部 agent 直接读你的订阅）。Linux 侧使用系统 WebKitGTK，不自行打包 WebKit。"
  }
}
